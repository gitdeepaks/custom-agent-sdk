# OpenAI provider credentials
# Required only when the application uses an OpenAI provider adapter.
OPENAI_API_KEY=

# Anthropic provider credentials
# Required only when the application uses an Anthropic provider adapter.
ANTHROPIC_API_KEY=
# Optional provider endpoints for compatible gateways, proxies, or test servers.
# Provider adapters must explicitly support these variables before they take effect.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com